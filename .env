# Copy to .env and fill in. `.env` is gitignored.
# Load with: set -a; . ./.env; set +a      (the Makefile does this for you)
ANSIBLE_HOST=your.server.example.com
ANSIBLE_USER=ansible
ANSIBLE_SSH_PORT=22
# Optional: private key used to connect (defaults to your ssh-agent / ~/.ssh)
# ANSIBLE_PRIVATE_KEY_FILE=~/.ssh/id_ed25519
